# =============================================================================
# LEGACY FastAPI application (app/) — DEVELOPMENT ONLY. Copy to the root .env.
# FastAPI is never deployed: there is no production configuration for it, and
# production / maintenance Next.js refuse FASTAPI_URL / BRIDGE_SECRET.
# Retained until the M6 legacy retirement. Placeholders only — never commit
# real values. (Formerly app/.env.production.example.)
# =============================================================================

# ─── Auth bridge (FastAPI ↔ Next.js, development only) ───────────────────────
# Must match BRIDGE_SECRET in web/.env.local exactly.
BRIDGE_SECRET=<same development secret as web/.env.local BRIDGE_SECRET>

# URL of the development Next.js app (used by the legacy bridge redirects)
NEXTJS_URL=http://localhost:3000

# ─── Anthropic (legacy AI explanations, development only) ───────────────────
# Optional: without it the legacy explainer returns static text. Not part of
# the Next.js contract (refused in Next.js production / maintenance).
# ANTHROPIC_API_KEY=<development Anthropic key — keep secret>

# ─── Email (legacy SMTP — development only, normally unset) ──────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
