# =============================================================================
# TenoTrainer — FastAPI production environment variables
# Copy to your hosting platform's environment variable configuration.
# NEVER commit actual values. This file documents keys only.
# =============================================================================

# ─── Anthropic (AI explanations) ─────────────────────────────────────────────
# Get your key at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=<Anthropic API key — keep secret>

# ─── Auth bridge (FastAPI → Next.js) ─────────────────────────────────────────
# CRITICAL: This value MUST match BRIDGE_SECRET in the Next.js production env.
# Generate a fresh secret for production: openssl rand -base64 48
# Never reuse the development secret in production.
BRIDGE_SECRET=<same fresh secret as in Next.js BRIDGE_SECRET>

# URL of the Next.js app (used to validate bridge tokens)
NEXTJS_URL=https://app.tenotrainer.com

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Note: Auth emails are handled by Supabase/Resend. This SMTP config is for
# any direct FastAPI email sending (currently unused in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Required only if SMS notifications are enabled.
TWILIO_ACCOUNT_SID=<Twilio Account SID>
TWILIO_AUTH_TOKEN=<Twilio Auth Token — keep secret>
TWILIO_FROM=<Twilio phone number, format: +1XXXXXXXXXX>
