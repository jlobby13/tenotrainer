# =============================================================================
# TenoTrainer — Next.js production environment variables
# Copy to your hosting platform's environment variable configuration.
# NEVER commit actual values. This file documents keys only.
#
# Production URL architecture:
#   tenotrainer.com          → marketing / landing site (separate deployment)
#   app.tenotrainer.com      → this Next.js application
#   api.tenotrainer.com      → FastAPI application (or internal URL)
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.tenotrainer.com

# ─── Supabase ────────────────────────────────────────────────────────────────
# Same project as dev — prod uses the same Supabase instance.
# Update site_url in Supabase Auth settings to https://app.tenotrainer.com at deploy.
NEXT_PUBLIC_SUPABASE_URL=https://kpdxlzqtvueiytwjamiw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — safe to expose, RLS enforced>

# SERVICE ROLE KEY — server-only, never prefix with NEXT_PUBLIC_.
# Inject via hosting platform secrets manager (Vercel env vars, Railway secrets, etc.)
SUPABASE_SERVICE_ROLE_KEY=<service role key — keep secret>

# SUPABASE_ACCESS_TOKEN is NOT needed at runtime — omit from production.
# It is only used locally by the Supabase CLI for migrations.
# In CI/CD pipelines, inject it as a pipeline secret, not a runtime env var.

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# tenotrainer.com is verified with Resend — all @tenotrainer.com addresses work.
RESEND_API_KEY=<Resend API key — keep secret>
RESEND_FROM=TenoTrainer <noreply@tenotrainer.com>

# ─── Auth bridge (Next.js → FastAPI) ─────────────────────────────────────────
# CRITICAL: This value MUST match BRIDGE_SECRET in the FastAPI production .env.
# Generate a fresh secret for production: openssl rand -base64 48
# Never reuse the development secret in production.
BRIDGE_SECRET=<generate fresh secret for production>

# URL of the production FastAPI instance (replace with actual host/port or domain)
FASTAPI_URL=https://api.tenotrainer.com

# =============================================================================
# At deploy time, also update in Supabase Dashboard → Auth → URL Configuration:
#   Site URL:           https://app.tenotrainer.com
#   Redirect allow list already includes https://app.tenotrainer.com/**
# =============================================================================
