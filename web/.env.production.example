# TenoTrainer — PRODUCTION configuration SHAPE (placeholders only).
# Configure these in the hosting platform's Production-scope environment
# (Vercel → Project → Settings → Environment Variables → Production).
# NEVER commit real values. The authoritative contract is
# docs/m3-configuration-contract.md; real values are provisioned in M3.4.
#
# Everything is read at runtime: a build needs no configuration, and no value
# is ever frozen into the build. An invalid configuration refuses to start
# (fail closed) and /api/ready answers 503 {"status":"unavailable"}.

# ─── Operating mode ──────────────────────────────────────────────────────────
TENOTRAINER_MODE=production
# (Planned unavailability uses TENOTRAINER_MODE=maintenance with the SAME
# configuration: patients unavailable, clinicians read-only, publication
# frozen; /api/ready still reports ready.)
# NODE_ENV and VERCEL_ENV are set by the platform — never configure them.

# ─── Canonical application origin ────────────────────────────────────────────
# Exact https origin, non-loopback, no path / trailing slash. Requests on any
# other host are redirected (GET/HEAD) or refused (other methods).
TENOTRAINER_APP_ORIGIN=https://<production application host>

# ─── Supabase (the NEW production project — never the development one) ──────
SUPABASE_URL=https://<production-project-ref>.supabase.co
TENOTRAINER_SUPABASE_PROJECT_REF=<production-project-ref>
SUPABASE_ANON_KEY=<production publishable / anon key>
SUPABASE_SERVICE_ROLE_KEY=<production secret key — keep secret>

# ─── C5 ──────────────────────────────────────────────────────────────────────
# C5 is always the patient runtime in production (leave unset or "true").
# C5_PATIENT_RUNTIME_ENABLED=true
# "true" enables prescription publication; "false"/unset = publication freeze.
C5_PRESCRIPTION_PUBLISH_ENABLED=true

# ─── Application email (invitations + clinician safety notifications) ───────
# Production requires resend. This does NOT configure Supabase Auth email
# (password recovery etc.), which is set up separately in the Supabase
# project's Auth/SMTP settings with its own auth/security sender identity.
TENOTRAINER_EMAIL_PROVIDER=resend
RESEND_API_KEY=<production Resend key restricted to the production sending domain — keep secret>
TENOTRAINER_NOTIFICATION_EMAIL_FROM=TenoTrainer <notifications@your-verified-production-domain.example>

# ─── Internal safety-dispatch credential ─────────────────────────────────────
# ≥ 32 random characters. During a rotation, set the new value as
# SAFETY_DISPATCH_SECRET_NEXT, move callers over, then promote it.
SAFETY_DISPATCH_SECRET=<generate: openssl rand -base64 48>
# SAFETY_DISPATCH_SECRET_NEXT=<optional rotation partner, distinct>

# ─── Refused in production / maintenance (startup fails if present) ─────────
# FASTAPI_URL, BRIDGE_SECRET (FastAPI is never deployed), ANTHROPIC_API_KEY,
# TENOTRAINER_DEV_EMAIL_RECIPIENTS, SAFETY_FAKE_PROVIDER_LOG / _SCRIPT,
# RESEND_BASE_URL, and every retired / NEXT_PUBLIC_* name
# (NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# RESEND_FROM, SAFETY_EMAIL_PROVIDER).

# =============================================================================
# PREVIEW deployments (Vercel Preview scope) — NOT production:
#   TENOTRAINER_MODE=development
#   TENOTRAINER_APP_ORIGIN=https://<stable preview alias>
#   SUPABASE_URL / keys = the registered DEVELOPMENT project only
#   TENOTRAINER_EMAIL_PROVIDER=disabled   (or fake)
#   Vercel Deployment Protection ON; no production secrets, Resend credential
#   or identity in Preview scope. Vercel's NODE_ENV=production does not make
#   a preview "production": only TENOTRAINER_MODE decides the mode.
#   Production deployments are built from Production scope; a Preview build
#   is never promoted to Production.
# =============================================================================
