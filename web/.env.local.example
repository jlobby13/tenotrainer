# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # anon/public key — Project Settings → API

# SERVICE ROLE KEY — server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # service_role key — Project Settings → API

# ─── Supabase CLI (local dev only — not needed at runtime) ───────────────────
# Used by `supabase db push`, `supabase migration list`, etc.
# Generate at supabase.com → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sign up at resend.com → API Keys → Create key.
RESEND_API_KEY=re_...
RESEND_FROM=TenoTrainer <noreply@yourdomain.com>

# ─── Auth bridge (Next.js → FastAPI) ─────────────────────────────────────────
# Shared secret — must match BRIDGE_SECRET in the FastAPI .env file exactly.
# Generate a secret: openssl rand -base64 48
BRIDGE_SECRET=<generate with: openssl rand -base64 48>

# URL of the FastAPI app (used when creating bridge redirects)
FASTAPI_URL=http://localhost:8000
