# TenoTrainer — DEVELOPMENT configuration (copy to web/.env.local).
# .env.local is gitignored — never commit it. Placeholders only below.
#
# The authoritative contract (every variable, every rule, every mode) is
# docs/m3-configuration-contract.md. Configuration is server-only and read
# at runtime; nothing here is ever sent to the browser.

# ─── Operating mode (required, no default) ───────────────────────────────────
TENOTRAINER_MODE=development

# ─── Canonical application origin (required) ─────────────────────────────────
# Exact origin: scheme://host[:port] — no path, no trailing slash.
# Generated links (invitations, safety notifications) use this.
TENOTRAINER_APP_ORIGIN=http://localhost:3000

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Development must use a project listed in web/config/resourceIdentity.json
# (developmentSupabaseProjects) or a local Supabase (loopback URL).
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_ANON_KEY=<development anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<development service-role / secret key — keep secret>
# Optional in development; when set it must equal the ref in SUPABASE_URL.
# TENOTRAINER_SUPABASE_PROJECT_REF=your-dev-project-ref

# ─── C5 feature gates (development only selects legacy vs C5) ────────────────
C5_PATIENT_RUNTIME_ENABLED=true
# C5_PRESCRIPTION_PUBLISH_ENABLED=true

# ─── Application email (invitations + safety notifications) ──────────────────
# Development default: disabled. A Resend key by itself NEVER enables email.
#   disabled — nothing is sent (recommended)
#   fake     — test double, never reaches the network
#   resend   — only under the full containment contract (below)
TENOTRAINER_EMAIL_PROVIDER=disabled
#
# Development `resend` requires ALL of: a separate development Resend key, a
# sender on a domain registered in resourceIdentity.json
# (developmentEmailDomains — today only the undeliverable
# dev-mail.tenotrainer.test, so real development email is NOT available),
# and an exact recipient allow-list (≤ 20 exact addresses, no wildcards).
# Leave these commented out unless that has been deliberately set up:
# RESEND_API_KEY=<separate development Resend key, re_…>
# TENOTRAINER_NOTIFICATION_EMAIL_FROM=TenoTrainer <notifications@your-registered-dev-domain.example>
# TENOTRAINER_DEV_EMAIL_RECIPIENTS=you@your-registered-dev-domain.example

# ─── Internal safety-dispatch credential (optional in development) ───────────
# ≥ 32 random characters, e.g. `openssl rand -base64 48`.
# SAFETY_DISPATCH_SECRET=<generate>
# SAFETY_DISPATCH_SECRET_NEXT=<optional rotation partner, distinct>

# ─── Legacy FastAPI bridge (development only; removed with M6) ───────────────
# Must match BRIDGE_SECRET in the root .env used by the FastAPI app.
BRIDGE_SECRET=<generate with: openssl rand -base64 48>
FASTAPI_URL=http://localhost:8000

# ─── Supabase CLI (not read by the app) ──────────────────────────────────────
# `supabase db push`, `supabase migration list`, … authenticate through the
# CLI's own session (`supabase login`). Do not put a SUPABASE_ACCESS_TOKEN here.

# ─── RETIRED — never configure (see the contract) ────────────────────────────
# NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# (replaced by the server-only names above), RESEND_FROM (→
# TENOTRAINER_NOTIFICATION_EMAIL_FROM) and SAFETY_EMAIL_PROVIDER (→
# TENOTRAINER_EMAIL_PROVIDER). Production / maintenance refuse them.
